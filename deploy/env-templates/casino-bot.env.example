# /root/casino-bot/.env — Casino v15 settlement bot.
# Real values are NOT in the repo. Sources are named per line.

# Default signer for the hardhat shim. Must be the v15 Vault owner: the bot
# tops up the seed pool and refuels cashier lanes from it.
# Source: v15-keys.json -> deployerPk
PRIVATE_KEY=0x...

# Same key again, read explicitly by the refuel/seed-top-up code. If unset the
# bot still settles but silently stops refuelling — lanes then run dry after
# ~4 transactions each (Somnia meters a settle at ~3M gas).
V15_OWNER_KEY=0x...

# Seeds are keccak(master, index). v15 MUST NOT share v14's master: a seed
# revealed by a v14 settle would predict the v15 bet at the same index.
# Source: v15-keys.json -> SEED_MASTER_KEY
SEED_MASTER_KEY_V15=0x...

# Per-game cashier wallets are derived from this: keccak(master, "cashier:<game>").
# Source: v15-keys.json -> CASHIER_MASTER_KEY
CASHIER_MASTER_KEY_V15=0x...

# Go through our own proxy? No — the bot is the settlement hot path and must not
# depend on another local process. It talks to Somnia directly with its own retries.
RPC_TESTNET=https://api.infra.testnet.somnia.network

POLL_MS=400
# Measured 2026-07-24: the old value of 12 was the actual throughput ceiling,
# not the chain. Somnia took 200/200 tx from one wallet at ~81 tx/s.
SETTLE_CONCURRENCY=48

# Gas refuel per cashier lane, in STT.
CASHIER_MIN=0.5
CASHIER_TOPUP=2

# Seed pool. Every bet/spin/round burns one; at zero every game reverts with
# NoSeedAvailable at once.
SEED_TOPUP_BELOW=150
SEED_TOPUP_BATCH=400
