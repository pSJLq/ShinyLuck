# /root/predictions/.env — prediction markets keeper + X oracle.
# Real values are NOT in the repo; copy from D:\...\ShinyLuck-predictions\.env

# Dedicated predictions deployer. A third owner key, separate from casino and
# poker on purpose (see /admin: isPredOwner).
PRIVATE_KEY=0x...

RPC_TESTNET=https://api.infra.testnet.somnia.network

# The oracle publishes its measurement JSON to a public repo.
XORACLE_GH_TOKEN=...
XORACLE_GH_REPO=...

# twscrape's plain httpx backend uses a 5s connect timeout that fails to reach
# x.com from most hosts; the curl_cffi backend impersonates a browser TLS stack.
TWS_HTTP_BACKEND=curl
