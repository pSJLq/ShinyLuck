# /root/shinyluck/.env — poker dealer + rpc-proxy.
# Real values are NOT in the repo; copy them from the local repo .env.

NETWORK_NAME=somniaTestnet
RPC_TESTNET=https://api.infra.testnet.somnia.network

# Dealer signer. Also the tournament/table owner. Source: local .env POKER_DEPLOYER_KEY
POKER_DEPLOYER_KEY=0x...

# Commit-reveal master for the v1 card layer; still read at boot.
# Source: local .env POKER_SEED_MASTER_KEY
POKER_SEED_MASTER_KEY=0x...

# Rake/fee sweep target once the bot holds more than it needs for gas.
PROFIT_WALLET=0x85b7D75cf35efC7E636FbDf3E82C92c6ceB5AC9D

# zkShuffle: proof verification pool + per-table worker wallets. 1 vCPU wanted
# 2/3; the new box has 2 cores, so these can go up after a load check.
ZK_VERIFY_WORKERS=2
ZK_WORKERS=3

# Compute the next deal during the current hand (~2-3s between hands instead of ~13s).
PREDEAL=1

# In-dealer faucet stays OFF: there is no official Somnia faucet and the UI
# must not imply one.
FAUCET=0

# rpc-proxy upstreams, tried in order. Ankr is independent infra from the
# Somnia partner list, so a gateway-wide 502 wave does not take all three down.
RPC_UPSTREAMS=https://api.infra.testnet.somnia.network,https://dream-rpc.somnia.network,https://rpc.ankr.com/somnia_testnet
