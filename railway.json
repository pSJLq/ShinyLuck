{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm ci --no-audit --no-fund && npx hardhat compile --quiet"
  },
  "deploy": {
    "startCommand": "node scripts/_reveal-bot-bootstrap.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "healthcheckPath": null,
    "healthcheckTimeout": 0
  }
}
