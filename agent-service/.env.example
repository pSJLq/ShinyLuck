# Somnia testnet RPC
RPC_URL=https://api.infra.testnet.somnia.network

# Relayer key (places bets for registered player-agents)
RELAYER_KEY=

# House Manager Agent key (separate hot key, owns the autonomous cron loop)
HM_PRIVATE_KEY=

# Deployed addresses (auto-written to deployments/somniaTestnet.json on deploy)
CASINO_ADDRESS=
REGISTRY_ADDRESS=
HM_ADDRESS=

# Player-agent API server
PORT=3001
DB_PATH=./data/strategies.json
TICK_INTERVAL_MS=30000

# HM cron tunables (intervals in ms; defaults are fine for testnet)
HM_TICK_INTERVAL_MS=60000
HM_MAXBET_PERIOD_MS=300000
HM_BANKROLL_PERIOD_MS=3600000
HM_THEME_PERIOD_MS=86400000

# Optional: Somnia LLM Inference Agent - if reachable, HM uses it to narrate
# decisions. Leave blank to use deterministic one-liners.
SOMNIA_LLM_URL=
LLM_AGENT_ID=12847293847561029384
# Canonical testnet AgentPlatform - see somnia-chain/agentathon network-config.
AGENT_PLATFORM=0x037Bb9C718F3f7fe5eCBDB0b600D607b52706776
