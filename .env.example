# ShinyLuck + ShinyPoker — environment variables template.
# Copy to .env (gitignored) and fill in your values. NEVER put real secrets
# or keys in THIS file — it is committed to git and public on GitHub.

# ──── CASINO (ShinyLuck) — REQUIRED ─────────────────────────────────────────

# Deployer EOA private key (without 0x prefix). NEVER commit real keys.
PRIVATE_KEY=

# Somnia Testnet RPC. Canonical infra endpoint per somnia-devrel SKILL.
RPC_TESTNET=https://api.infra.testnet.somnia.network

# Mainnet RPC - fill before mainnet deploy.
RPC_MAINNET=https://api.infra.mainnet.somnia.network

# Privy app credentials - get one at https://dashboard.privy.io
Privy_App_Id=
Privy_App_Secret=

# Casino server-seed master key (provably-fair commit-reveal derivation).
SEED_MASTER_KEY=

# ──── DEPLOYMENT TUNABLES (optional, defaults work) ─────────────────────────

# Initial casino bankroll (in STT) seeded by the deployer.
INITIAL_BANKROLL_ETH=50

# Number of server-seed hashes provisioned in the initial batch.
SEED_BATCH_SIZE=200

# Address that becomes the off-chain HouseManager agent signer.
# Defaults to the deployer if empty.
HM_AGENT_ADDRESS=

# Address that becomes the PlayerAgentRegistry relayer (places bets for
# player agents). Defaults to the deployer if empty.
RELAYER_ADDRESS=

# Gas reporter on test runs.
REPORT_GAS=false

# ──── SOMNIA AGENT PLATFORM ─────────────────────────────────────────────────
# Canonical addresses per github.com/somnia-chain/agentathon
# references/network-config.json. Leave blank to use the testnet defaults
# baked into scripts/deploy.js (mainnet auto-switches on network=somniaMainnet).
AGENT_PLATFORM=
# Optional agent ID overrides - leave blank to use canonical IDs from
# references/agents.json (LLM Inference, JSON API, Parse Website, House Manager).
AGENT_ID_JSON=
AGENT_ID_LLM=
AGENT_ID_PARSE=
AGENT_ID_HM=

# ──── SHINYPOKER ─────────────────────────────────────────────────────────────

# Poker deployer/operator key — SEPARATE from the casino PRIVATE_KEY so the
# reveal-bot's nonce is never touched by poker ops. Also the dealer bot's key.
POKER_DEPLOYER_KEY=

# Poker's own seed-derivation master key (falls back to SEED_MASTER_KEY if unset).
POKER_SEED_MASTER_KEY=

# ──── OPTIONAL / INFRA ───────────────────────────────────────────────────────

# Subgraph hosted-service deploy key (see subgraph/README.md).
ORMI_API_KEY=

# Railway account token — only for manual `railway` CLI ops on the casino
# reveal-bot deployment. Not read by any script directly.
RAILWAY_KEY=

# VPS SSH creds for scripts/_vps.py (poker dealer-bot ops). NEVER commit real values.
IP=
LOGIN=
PASS=
