# ShinyLuck environment variables
# Скопируй в .env (он в .gitignore) и заполни значениями.

# Приватный ключ деплоера (без 0x). НИКОГДА не коммить настоящий ключ.
PRIVATE_KEY=

# Somnia Testnet (Shannon)
RPC_TESTNET=https://dream-rpc.somnia.network

# Somnia Mainnet — заполнить перед финальным деплоем (см. docs.somnia.network)
RPC_MAINNET=

# Опционально: gas reporter
REPORT_GAS=false

# Адреса Somnia Agent Platform / Registry (testnet)
AGENT_PLATFORM=0x5E5205CF39E766118C01636bED000A54D93163E6
AGENT_REGISTRY=0xaD3101C37F091593fEe7cb471e92b5E9A1205194

# Somnia agent IDs
AGENT_ID_JSON_API=131742929374160097713
AGENT_ID_LLM=128472938475610293844
AGENT_ID_PARSE_WEBSITE=128754011420709690852
AGENT_ID_HOUSE_MANAGER=119284756103948572617


Privy_App_Id=
Privy_App_Secret=

