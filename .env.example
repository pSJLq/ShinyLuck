# ShinyLuck - environment variables template.
# Copy to .env (gitignored) and fill in your values.

# ──── REQUIRED ──────────────────────────────────────────────────────────────

# Deployer EOA private key (without 0x prefix). NEVER commit real keys.
PRIVATE_KEY=

# Somnia Testnet RPC. Canonical infra endpoint per somnia-devrel SKILL.
RPC_TESTNET=https://api.infra.testnet.somnia.network

# Privy app credentials - get one at https://dashboard.privy.io
Privy_App_Id=
Privy_App_Secret=

# ──── DEPLOYMENT TUNABLES (optional, defaults work) ─────────────────────────

# Initial casino bankroll (in STT) seeded by the deployer.
INITIAL_BANKROLL_ETH=50

# Number of server-seed hashes provisioned in the initial batch.
SEED_BATCH_SIZE=200

# Address that becomes the off-chain HouseManager agent signer.
# Defaults to the deployer if empty.
HM_AGENT_ADDRESS=

# Address that becomes the PlayerAgentRegistry relayer (places bets for
# player agents). Defaults to the deployer if empty.
RELAYER_ADDRESS=

# ──── SOMNIA AGENT PLATFORM ─────────────────────────────────────────────────
# Canonical addresses per github.com/somnia-chain/agentathon
# references/network-config.json. Leave blank to use the testnet defaults
# baked into scripts/deploy.js (mainnet auto-switches on network=somniaMainnet).
AGENT_PLATFORM=
# Optional agent ID overrides - leave blank to use canonical IDs from
# references/agents.json (LLM Inference, JSON API, Parse Website).
AGENT_ID_JSON=
AGENT_ID_LLM=
AGENT_ID_PARSE=
AGENT_ID_HM=

# ──── OPTIONAL ──────────────────────────────────────────────────────────────

# Mainnet RPC - fill before mainnet deploy.
RPC_MAINNET=https://api.infra.mainnet.somnia.network

# Gas reporter on test runs.
REPORT_GAS=false
