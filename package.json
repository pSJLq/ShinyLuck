{
  "name": "shinyluck",
  "version": "0.1.0",
  "private": true,
  "description": "ShinyLuck - agent-native casino on Somnia",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:gas": "REPORT_GAS=true hardhat test",
    "coverage": "hardhat coverage",
    "node": "hardhat node",
    "clean": "hardhat clean",
    "deploy:testnet": "hardhat run scripts/deploy.js --network somniaTestnet",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network somniaMainnet",
    "verify:testnet": "hardhat verify --network somniaTestnet",
    "verify:mainnet": "hardhat verify --network somniaMainnet",
    "build:privy": "node scripts/build-privy-vendor.js",
    "dev:frontend": "node scripts/_dev-frontend.js",
    "dev:reveal-bot": "node scripts/_dev-reveal-bot.js",
    "dev:demo-bot": "node demo-bot/index.js",
    "dev:agent-service": "node agent-service/index.js",
    "dev:hm-cron": "node agent-service/hm-cron.js",
    "dev:all": "concurrently -n FRONTEND,REVEAL,AGENT,HMCRON,DEMO -c blue,green,magenta,red,yellow -k --kill-others-on-fail \"npm:dev:frontend\" \"npm:dev:reveal-bot\" \"npm:dev:agent-service\" \"npm:dev:hm-cron\" \"npm:dev:demo-bot\"",
    "dev:play": "concurrently -n FRONTEND,REVEAL,AGENT,HMCRON -c blue,green,magenta,red -k --kill-others-on-fail \"npm:dev:frontend\" \"npm:dev:reveal-bot\" \"npm:dev:agent-service\" \"npm:dev:hm-cron\"",
    "play": "node scripts/_supervise.js",
    "test:browser": "node test/browser-e2e.mjs",
    "test:pages": "node test/poker-page-load.smoke.test.mjs",
    "test:tournament": "node test/browser-e2e-tournament.mjs",
    "test:mtt": "node test/browser-e2e-mtt.mjs",
    "test:hostile": "node test/poker-hostile-browser.mjs"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@nomicfoundation/ignition-core": "^0.15.15",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.8.0",
    "chai": "^4.5.0",
    "concurrently": "^9.2.1",
    "dotenv": "^16.4.5",
    "esbuild": "^0.28.0",
    "ethers": "^6.16.0",
    "hardhat": "^2.22.10",
    "hardhat-gas-reporter": "^1.0.10",
    "playwright": "^1.62.1",
    "solidity-coverage": "^0.8.17",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@noble/curves": "^1.9.2",
    "@openzeppelin/contracts": "^5.0.2",
    "@privy-io/cross-app-connect": "^0.5.8",
    "@privy-io/react-auth": "^3.26.0",
    "@somnia-chain/reactivity": "^0.1.10",
    "@somnia-chain/reactivity-contracts": "^0.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "viem": "^2.37.13"
  },
  "engines": {
    "node": ">=20"
  }
}
